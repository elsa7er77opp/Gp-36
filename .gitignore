# Environment
venv/
__pycache__/
*.pyc
*.whl

# Datasets and caches (tracked by SHA-256 manifests in manifests/, not by git)
road_hazards/
road_hazards_v2/
road_hazards_v3*/
*.npy
*.cache

# Model weights (tracked by manifests)
*.pt
*.onnx
*.engine

# Large run artefacts: keep args.yaml, results.csv and curves; drop batch mosaics
runs/**/train_batch*.jpg
runs/**/val_batch*.jpg

# Generated review material (regenerable from tools/)
review/**/*.jpg

# Office lock files
~$*

# Logs
*.log

# Added 2026-10-30 (baseline commit): generated archives and bulky run images
*.zip
runs/**/*.png
runs/**/*.jpg
*.bak_*
review/**/*.zip

# Added 2026-11-04 (before the first push to a private GitHub repo): data never goes to git
parts_r3/**/images/
parts_r3/**/labels/
external_tests/**/images/
external_tests/**/labels/
runs/detect/runs/
runs/**/predictions.json
*.npz
# project rule "never upload project images": photo sheets and Word files that may embed photos stay local
supervisor_*/**/*.jpg
supervisor_*/**/*.docx
*.jpg
